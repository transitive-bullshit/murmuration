yarn-error.log*

# pnpm
.pnpm-store

# local env files
.env
.env.local
local.env
.env.build
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# local work
/work

# vite
/dist

# derived analytics cache (built from your local Birdclaw archive; private)
/.cache

# the publishable snapshot from `pnpm export` (DM text stripped); deployed, not committed
/data

# local agent/editor launch configs
/.claude

# Vercel CLI (`vercel link` writes a short-lived OIDC token here)
.env*.local
