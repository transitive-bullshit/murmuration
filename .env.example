# Optional. Enables OpenAI embeddings (text-embedding-3-large) and image
# captions for multimodal topics. Computed once per tweet and cached in .cache/.
OPENAI_API_KEY=

# Optional. New image captions / embeddings one build pays for without --yes
# (defaults 200 / 2000); see contributing.md, "Paid requests".
MURMURATION_MAX_NEW_CAPTIONS=
MURMURATION_MAX_NEW_EMBEDDINGS=

# Optional. Public URL of your deployed site, for share images, the canonical
# link and sitemap.xml. Defaults to package.json "homepage".
SITE_URL=
